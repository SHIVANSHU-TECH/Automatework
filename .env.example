# ─── AI ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── Google PageSpeed Insights API (free — get at console.cloud.google.com) ──
# Enable "PageSpeed Insights API" in Google Cloud Console, then create an API key
PAGESPEED_API_KEY=your_google_api_key_here

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:./data/app.db

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production

# JWT signing secret — use a long random string in production
APP_AUTH_SECRET=replace-with-a-long-random-secret

# ─── Firebase Admin (for ID token verification on the API) ────────────────────
# Option A: Set GOOGLE_APPLICATION_CREDENTIALS to path of service account JSON
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# Option B: Set individual vars (download from Firebase Console > Project Settings > Service Accounts)
# FIREBASE_PROJECT_ID=trainerform-52f85
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@trainerform-52f85.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Local dev:
# NEXT_PUBLIC_API_URL=http://localhost:4000
# Production:
NEXT_PUBLIC_API_URL=https://automatework-tmfr.onrender.com

# Web app URL — used for generating short link URLs (yourapp.vercel.app/s/xxx)
# Local dev: APP_URL=http://localhost:3000
APP_URL=https://automatework-web.vercel.app
